{
  "version": 2,
  "builds": [
    { "src": "api/leads.js", "use": "@vercel/node" },
    { "src": "api/request_scrape.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/leads", "dest": "api/leads.js" },
    { "src": "/api/request_scrape", "dest": "api/request_scrape.js" },
    { "src": "/data/(.*)", "dest": "public/data/$1" },
    { "src": "/(.*)", "dest": "public/$1" }
  ]
}
